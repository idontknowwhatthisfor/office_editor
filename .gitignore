.DS_Store
captures/
node_modules/

# Release signing
keystore.properties
*.jks
*.keystore

# Built by `npm run build` in web/ (run automatically by Gradle)
app/src/main/assets/web/
web/public/pdfjs/

# Real documents used for testing stay out of the repo (personal, large or copyrighted).
# The synthetic samples are regenerated by test-files/make_samples.py.
test-files/*
!test-files/make_samples.py
!test-files/make_xlsx_samples.applescript
!test-files/excel_text_dump.applescript
!test-files/make_pptx_sample.py
!test-files/pptx_resave.applescript
!test-files/make_pptx_native.applescript
!test-files/make_pdf_form.mjs
